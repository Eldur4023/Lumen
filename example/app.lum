# Lumen example project.
#   $ lumen ./example

app:
    name      "Lumen Example"
    version   "2.0.0"
    port      8080
    templates "./example/templates"

    static "/static" -> "./example/public"
    health


get endpoint("/"):
    return render("index.html", title="Lumen 2.0", nota="edit me and save")

get endpoint("/hello"):
    return text("hello from lumen_script")

get endpoint("/api"):
    return { "ok": true, "motor": "lumen", "hito": 1 }

get endpoint("/ir"):
    return redirect("/")
