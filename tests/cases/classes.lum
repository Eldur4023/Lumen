app:
    port 8790

class Alta:
    string name
    int    age

    validate:
        name != ""   "name: required"
        age >= 18     "age: must be of age"

class Punto:
    int x
    int y

    fn int cuadrado():
        return this.x * this.x + this.y * this.y

    fn string label(string prefijo = "P"):
        return prefijo + "(" + str(this.x) + "," + str(this.y) + ")"

fn int doble(int x):
    return x * 2

fn int factorial(int n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

fn int infinita(int n):
    return infinita(n + 1)

get endpoint("/__ping__"):
    return { "ok": true }

post endpoint("/add", Alta a):
    return { "creado": a.name }.status(201)

get endpoint("/punto/:x/:y", int x, int y):
    Punto p = Punto(x, y)
    return { "cuadrado": p.cuadrado() }

get endpoint("/label/:x/:y", int x, int y):
    Punto p = Punto(x, y)
    return { "one": p.label(), "other": p.label("Q") }

get endpoint("/doble/:n", int n):
    return { "r": doble(n) }

get endpoint("/factorial/:n", int n):
    return { "r": factorial(n) }

get endpoint("/infinita"):
    return { "r": infinita(1) }

on error 422:
    return { "count": len(error.messages), "details": error.messages }
