import sqlite

app:
    port 8820

    sqlite:
        file "./pruebas-sqlite-tipos.db"
        pool 8

get endpoint("/__ping__"):
    return { "ok": true }

# ── Esquema ──────────────────────────────────────────────────────────────────
#
# Se crea desde aqui y no con el CLI de sqlite3, para que la suite necesite solo
# el binario de Lumen.

get endpoint("/crear"):
    await sqlite.exec("drop table if exists articulos")
    await sqlite.exec("drop table if exists cuentas")
    await sqlite.exec("drop table if exists tipos")
    await sqlite.exec("drop table if exists afinidad")

    await sqlite.exec("""
        create table articulos (
            id     integer primary key autoincrement,
            titulo text not null,
            cuerpo text,
            autor  text,
            vistas integer not null default 0
        )
        """)
    await sqlite.exec("create table cuentas (id integer primary key autoincrement, nombre text, saldo integer)")
    await sqlite.exec("""
        create table tipos (
            id      integer primary key,
            t_int   integer,
            t_neg   integer,
            t_real  real,
            t_texto text,
            t_blob  blob,
            t_nulo  text,
            t_bool  integer
        )
        """)
    # sqlite no impone el tipo declarado: una columna integer puede guardar un
    # texto.  Esta tabla existe para comprobar que sale lo que HAY, no lo que
    # dice la declaracion.
    await sqlite.exec("create table afinidad (id integer primary key, valor integer)")

    # 4000 caracteres, muy por encima de cualquier buffer de reserva.
    string largo = ""
    int i = 0
    while i < 400:
        largo = largo + "0123456789"
        i++

    await sqlite.exec("insert into articulos (titulo, cuerpo, autor, vistas) values (?, ?, ?, ?)", "largo", largo, "Ana", 1)
    await sqlite.exec("insert into articulos (titulo, cuerpo, autor, vistas) values (?, ?, ?, ?)", "corto", "un cuerpo breve", "Bob", 2)
    await sqlite.exec("insert into articulos (titulo, cuerpo, autor, vistas) values (?, ?, ?, ?)", "unicode ñ 🐻", "cuerpo con ñ y 🐻", "Cé", 3)

    await sqlite.exec("insert into cuentas (nombre, saldo) values (?, ?)", "ana", 100)
    await sqlite.exec("insert into cuentas (nombre, saldo) values (?, ?)", "bob", 100)

    # El blob lleva bytes que NO son UTF-8 validos: si salen crudos al JSON, el
    # documento deja de ser legible para cualquier cliente.
    await sqlite.exec("""
        insert into tipos (id, t_int, t_neg, t_real, t_texto, t_blob, t_nulo, t_bool)
        values (1, 9223372036854775807, -9223372036854775808, 3.141592653589793,
                'con acentos: añoñó y un emoji 🐻', x'00FF80FE', null, 1)
        """)

    # Un texto con un byte nulo dentro: sqlite lo guarda y lo devuelve entero.
    await sqlite.exec("insert into tipos (id, t_texto) values (2, ?)", "antes")
    await sqlite.exec("update tipos set t_texto = cast(x'6100620063' as text) where id = 2")

    # Una columna declarada integer con un texto dentro.
    await sqlite.exec("insert into afinidad (id, valor) values (1, ?)", "no soy un numero")
    await sqlite.exec("insert into afinidad (id, valor) values (2, ?)", 42)

    return { "ok": true }

# ── Lo basico ────────────────────────────────────────────────────────────────

get endpoint("/todos"):
    return await sqlite.query("select id, titulo, autor, vistas from articulos order by id")

get endpoint("/uno/:id", int id):
    List<Json> filas = await sqlite.query("select id, titulo, autor, vistas from articulos where id = ?", id)
    if len(filas) == 0:
        return status(404)
    return filas[0]

get endpoint("/largo"):
    List<Json> filas = await sqlite.query("select cuerpo from articulos where titulo = ?", "largo")
    if len(filas) == 0:
        return status(404)
    return { "recibido": len(filas[0]["cuerpo"]), "esperado": 4000 }

# ── Tipos ────────────────────────────────────────────────────────────────────

get endpoint("/tipos"):
    List<Json> filas = await sqlite.query("select * from tipos where id = ?", 1)
    if len(filas) == 0:
        return status(404)
    return filas[0]

# length() de sqlite cuenta hasta el primer NUL, por definicion del motor.  Para
# los bytes de verdad hay que preguntar por el blob.  Lo que se comprueba aqui es
# que el driver devuelve la cadena ENTERA, con los nulos dentro.
get endpoint("/nulo_en_texto"):
    return await sqlite.query("select id, t_texto, length(cast(t_texto as blob)) as bytes, length(t_texto) as hasta_el_nulo from tipos where id = ?", 2)

# sqlite no impone el tipo declarado: sale lo que hay guardado de verdad.
get endpoint("/afinidad"):
    return await sqlite.query("select id, valor, typeof(valor) as tipo from afinidad order by id")

# Infinito: sqlite lo admite en una columna real.
get endpoint("/infinito"):
    return await sqlite.query("select 9e999 as inf, -9e999 as menosinf")

# ── La cache de sentencias ───────────────────────────────────────────────────
#
# La misma consulta se prepara una vez y se reutiliza.  Si al reutilizarla no se
# limpian los enlaces anteriores, la segunda llamada devolveria lo de la
# primera.  Esta ruta la ejecuta N veces con parametros distintos.

get endpoint("/repetida/:id", int id):
    List<Json> filas = await sqlite.query("select titulo from articulos where id = ?", id)
    if len(filas) == 0:
        return { "titulo": null }
    return filas[0]

# La misma consulta con un parametro que a veces es null: si `clear_bindings` no
# se llamara, el null se quedaria pegado del turno anterior.
get endpoint("/opcional", string autor = ""):
    if autor == "":
        return await sqlite.query("select count(*) as n from articulos where autor is ?", null)
    return await sqlite.query("select count(*) as n from articulos where autor is ?", autor)

# ── Unicode e inyeccion ──────────────────────────────────────────────────────

get endpoint("/unicode"):
    return await sqlite.query("select id, titulo from articulos where titulo = ?", "unicode ñ 🐻")

get endpoint("/inyeccion", string q = "x"):
    List<Json> filas = await sqlite.query("select id from articulos where titulo = ?", q)
    return { "encontrados": len(filas) }

# ── Escritura ────────────────────────────────────────────────────────────────

post endpoint("/alta/:nombre", string nombre):
    await sqlite.exec("insert into articulos (titulo, autor) values (?, ?)", nombre, "test")
    int id = await sqlite.last_id()
    return { "id": id }.status(201)

post endpoint("/borra/:id", int id):
    int filas = await sqlite.exec("delete from articulos where id = ?", id)
    return { "filas": filas }

# ── Transacciones ────────────────────────────────────────────────────────────

post endpoint("/transfiere"):
    await sqlite.begin()
    await sqlite.exec("update cuentas set saldo = saldo - 30 where nombre = ?", "ana")
    await sqlite.exec("update cuentas set saldo = saldo + 30 where nombre = ?", "bob")
    await sqlite.commit()
    return { "ok": true }

post endpoint("/deshace_verboso"):
    Json b = await sqlite.begin()
    Json u = await sqlite.exec("update cuentas set saldo = saldo - 50 where nombre = ?", "ana")
    Json r = await sqlite.rollback()
    return { "begin": b, "update": u, "rollback": r }

get endpoint("/saldos"):
    return await sqlite.query("select nombre, saldo from cuentas order by nombre")

# ── Errores ──────────────────────────────────────────────────────────────────

get endpoint("/tabla_mala"):
    return await sqlite.query("select * from no_existe")

get endpoint("/parametros_de_menos"):
    return await sqlite.query("select * from articulos where id = ? and titulo = ?", 1)
