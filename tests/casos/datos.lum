import sqlite

app:
    port 8790

    sqlite:
        file "./pruebas-suite.db"
        pool 4

get endpoint("/__ping__"):
    return { "ok": true }

get endpoint("/crear"):
    await sqlite.exec("drop table if exists cuentas")
    await sqlite.exec("create table cuentas (id integer primary key autoincrement, nombre text, saldo integer)")
    return { "ok": true }

post endpoint("/alta/:nombre", string nombre):
    await sqlite.exec("insert into cuentas (nombre, saldo) values (?, 100)", nombre)
    int id = await sqlite.last_id()
    return { "id": id }.status(201)

get endpoint("/todos"):
    return await sqlite.query("""
        select id, nombre, saldo
        from cuentas
        order by id
        """)

get endpoint("/uno/:id", int id):
    List<Json> filas = await sqlite.query("select nombre from cuentas where id = ?", id)
    if len(filas) == 0:
        return status(404)
    return filas[0]

get endpoint("/busca", string q):
    List<Json> filas = await sqlite.query("select id from cuentas where nombre = ?", q)
    return { "encontrados": len(filas) }

get endpoint("/saldos"):
    List<Json> filas = await sqlite.query("select saldo from cuentas where nombre = ?", "ana")
    return filas[0]

post endpoint("/transfiere"):
    await sqlite.begin()
    await sqlite.exec("update cuentas set saldo = saldo - 30 where nombre = ?", "ana")
    await sqlite.exec("update cuentas set saldo = saldo + 30 where nombre = ?", "bob")
    await sqlite.commit()
    return { "ok": true }

post endpoint("/deshace"):
    await sqlite.begin()
    await sqlite.exec("update cuentas set saldo = 0 where nombre = ?", "ana")
    await sqlite.rollback()
    return { "deshecho": true }

get endpoint("/malo"):
    Json r = await sqlite.query("select * from no_existe")
    return r
