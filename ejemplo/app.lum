# Proyecto de ejemplo de Lumen 2.0.
#   $ lumen ./ejemplo

app:
    name      "Ejemplo Lumen"
    version   "2.0.0"
    port      8080
    templates "./ejemplo/templates"

    static "/static" -> "./ejemplo/public"
    health


get endpoint("/"):
    return render("index.html", titulo="Lumen 2.0", nota="editame y guarda")

get endpoint("/hola"):
    return text("hola desde lumen_script")

get endpoint("/api"):
    return { "ok": true, "motor": "lumen", "hito": 1 }

get endpoint("/ir"):
    return redirect("/")
